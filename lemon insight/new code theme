    width:220px;
    height:220px;

    top:-60px;
    right:-60px;
}

.brand-panel .blob-2{

    width:160px;
    height:160px;

    bottom:-50px;
    left:-40px;

    background:rgba(255,214,10,.12);
}

.brand-panel .blob-3{

    width:90px;
    height:90px;

    top:40%;
    right:10%;

    background:rgba(255,214,10,.10);
}

.brand-badge{

    width:56px;
