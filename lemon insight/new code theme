/* ============================================================
   CUSTOM TABLE
   ============================================================ */

.ih-table-wrap{

    overflow:auto;

    border:1px solid var(--line);

    border-radius:14px;

    background:var(--tbl-bg);

    margin-bottom:12px;
}

.ih-table{

    border-collapse:collapse;

    width:100%;

    font-size:.85rem;
}

.ih-table thead th{

    position:sticky;

    top:0;

    z-index:1;

    background:var(--tbl-head-bg);

    color:var(--tbl-head-ink) !important;

    font-weight:800;

    text-align:left;

    padding:10px 12px;

    border-bottom:2px solid var(--lemon);

    white-space:nowrap;
}

.ih-table tbody th{

    color:var(--muted);

    font-weight:600;

    text-align:right;

    padding:8px 12px;

    border-bottom:1px solid var(--line);
}

.ih-table td{

    padding:8px 12px;

    border-bottom:1px solid var(--line);

    color:var(--ink);

    white-space:nowrap;

    text-align:right;
}

.ih-table tbody tr:hover td{

    background:var(--lemon-tint);
}


/* ============================================================
   AUTH SCREEN
   ============================================================ */

.auth-bg-blob-a,
.auth-bg-blob-b{

    position:fixed;

    border-radius:50%;

    filter:blur(90px);

    z-index:-1;

    opacity:.35;

    pointer-events:none;
}

.auth-bg-blob-a{

    width:500px;
    height:500px;

    top:-180px;
    left:-180px;

    background:
        radial-gradient(
            circle,
            #FFF3A3 0%,
            transparent 70%
        );
}

.auth-bg-blob-b{

    width:520px;
    height:520px;

    bottom:-220px;
    right:-170px;

    background:
        radial-gradient(
            circle,
            #FFE94D 0%,
            transparent 70%
        );
}

.brand-panel{

    position:relative;

    overflow:hidden;

    background:var(--lemon-tint);

    border:1px solid var(--line);

    border-radius:22px;

    padding:44px 38px;

    height:100%;

    min-height:560px;

    color:var(--ink);

    display:flex;

    flex-direction:column;

    justify-content:center;
